# Byte-compiled / caches
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
# hypothesis keeps the inputs that failed here, so a rerun tries them first. Useful
# locally, meaningless to anyone else.
.hypothesis/
.coverage
htmlcov/

# Packaging / envs
*.egg-info/
build/
dist/
.venv/
venv/

# The price cache stays out: 8 MB of Yahoo data, reproducible with `xsbt fetch`, and not
# ours to hand around. Anchored with a leading slash, because an unanchored `data/` also
# matches src/xsbt/data and quietly drops the data layer from the repo.
/data/

# `runs/` is checked in on purpose, so the two reports can be opened without installing
# anything first. `/reports/` is the scratch path for `xsbt report --out`, so it stays out.
/reports/

# Editors / OS
.vscode/
.idea/
.DS_Store
